<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.pixelpaw</groupId>
    <artifactId>pixelpaw</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>pw-pet</artifactId>
  <!-- 版本管理（父 pom 不统一管理时手动指定） -->
  <properties>
    <mybatis-plus-spring-boot3.version>3.5.9</mybatis-plus-spring-boot3.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.pixelpaw</groupId><artifactId>pw-common</artifactId><version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><optional>true</optional>
    </dependency>
    <!-- Spring Data Redis -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- MyBatis-Plus（含 Spring Boot 3 适配 starter） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus-spring-boot3.version}</version>
    </dependency>
    <!-- 3.5.6+ 起，PaginationInnerInterceptor 等 JSqlParser 相关拦截器被拆到独立模块，starter 不再传递 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>${mybatis-plus-spring-boot3.version}</version>
    </dependency>
  </dependencies>
</project>
